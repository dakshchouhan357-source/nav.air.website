# NAV AIR Backend Configuration
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# Email Configuration
# For Gmail: Enable 2FA and create App Password (not regular password)
# For SendGrid: Get API key from sendgrid.com
# For any SMTP: Get credentials from your email provider

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com

# Business Email
BUSINESS_EMAIL=air.navpure@gmail.com

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000